rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function isProductOwner() {
      return signedIn() && resource.data.seller.uid == request.auth.uid;
    }

    function updatesOnlyProductLikes() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
    }

    function updatesOnlyChatMeta() {
      return isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastTime', 'unreadCount', 'timestamp', 'completed']);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.seller.uid == request.auth.uid;
      allow update: if isProductOwner() || updatesOnlyProductLikes();
      allow delete: if isProductOwner();
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow read: if isParticipant();
      allow update: if updatesOnlyChatMeta();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
